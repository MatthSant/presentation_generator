{
  "name": "ltv-app",
  "version": "1.0.0",
  "description": "Analytics report viewer",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*.test.ts\"",
    "coverage": "c8 --reporter=text --reporter=html node --import tsx --test --test-force-exit \"test/**/*.test.ts\"",
    "validate": "tsx scripts/validate.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "c8": "^10.1.3",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
