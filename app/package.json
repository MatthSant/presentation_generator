{
  "name": "ltv-app",
  "version": "2.0.0",
  "description": "Analytics report viewer — TypeScript, 3-layer data model",
  "type": "module",
  "scripts": {
    "start": "node dist/server/index.js",
    "dev": "concurrently -n server,client -c blue,magenta \"tsx watch src/server/index.ts\" \"tsc -p tsconfig.client.json --watch --preserveWatchOutput\"",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-force-exit \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*.test.ts\"",
    "coverage": "c8 --reporter=text --reporter=html node --import tsx --test --test-force-exit \"test/**/*.test.ts\"",
    "validate": "tsx scripts/validate.ts",
    "user:add": "tsx scripts/add-user.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "better-sqlite3": "^12.10.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^28.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "c8": "^10.1.3",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.4",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0"
  }
}
