# Copie este arquivo para app/.env e preencha. NUNCA comite o .env (é gitignored).
# O servidor lê estas variáveis no start (src/server/env.ts).

# --- Claude (insights + aprofundamento) ---
# Sua chave da API Anthropic. Sem ela (ou com CLAUDE_MOCK=1), roda em modo mock.
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo. Default: claude-sonnet-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Force o modo mock mesmo com chave (deixe vazio/comente para usar o Claude real):
# CLAUDE_MOCK=1

# --- Auth ---
# AUTH_DISABLED=1            # desliga a autenticação (só em dev)
# SEED_EMAIL=demo@witly.com  # cria/garante este consultor no start
# SEED_PASSWORD=troque-isto

# --- Geração ---
# GEN_SECRET=...             # se setado, /generate exige header x-gen-secret
# PYTHON_BIN=py              # interpretador Python (Windows: py · *nix: python3)
